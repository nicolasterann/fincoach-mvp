# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin (no trailing slash). Used to build the absolute
# signup-confirmation redirect (emailRedirectTo → /auth/confirm) so the email
# link points at the real domain instead of localhost. Must match the Supabase
# dashboard Site URL and be in its Redirect URLs allowlist. Falls back to the
# Vercel production host, then http://localhost:3000 for local dev. Non-secret.
NEXT_PUBLIC_SITE_URL=https://www.soykipu.com

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSACTION_PARSER_MODEL=gpt-5.4-mini
OPENAI_COACH_MODEL=gpt-5.4
OPENAI_ONBOARDING_MODEL=gpt-5.4
OPENAI_DEEP_ANALYSIS_MODEL=gpt-5.5
# Stage 12 capture: vision (receipts/screenshots/PDF statements) and voice
# notes. When unset, vision falls back to OPENAI_COACH_MODEL and
# transcription to whisper-1.
OPENAI_VISION_MODEL=gpt-5.4
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Parser mode options: basic, ai, ai_with_basic_fallback
TRANSACTION_PARSER_MODE=basic

# Coach response mode options: fallback, ai
COACH_RESPONSE_MODE=fallback

# AI-native agent front door (Stage 1). off = legacy deterministic pipeline
# only (default); shadow = reserved for observed/read-only runs; on = the Kipu
# agent reasons over live memory and acts through safe tools, with the legacy
# pipeline as automatic fallback on any failure. See docs/AI_NATIVE_ARCHITECTURE.md
KIPU_AGENT_MODE=off

# Onboarding engine mode options: mock, ai, ai_with_mock_fallback.
# AI-first is the product (Stage 11): when unset, the code defaults to
# ai_with_mock_fallback — the conversational AI conducts onboarding and the
# deterministic mock only catches engine failures. Use "mock" strictly for
# offline/local development without an OpenAI key.
ONBOARDING_ENGINE_MODE=ai_with_mock_fallback

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=

# Public bot handle (no @) used to build the in-app "Conectar Telegram" deep
# link (https://t.me/<username>?start=<token>). NON-SENSITIVE. Configurable so
# the bot username can change without code edits; defaults to fincoach_latam_bot.
TELEGRAM_BOT_USERNAME=fincoach_latam_bot

# Optional dedicated secret for signing the self-serve Telegram link token
# (Stage 21.3). SENSITIVE. If unset, the flow falls back to
# SUPABASE_SERVICE_ROLE_KEY (server-only; HMAC never reveals it), so this is not
# required for the flow to work — set it only to decouple link signing.
TELEGRAM_LINK_SECRET=

# Inbound email capture (Stage 12 foundation — DISABLED until production
# setup). Requires: an email-receiving provider (e.g. Resend Inbound or
# Mailgun Routes) posting parsed emails to /api/inbound-email with the
# x-inbound-email-secret header, plus MX records on INBOUND_EMAIL_DOMAIN.
# Leave INBOUND_EMAIL_SECRET empty to keep the channel off (route answers 503).
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=inbox.soykipu.com

# Internal /dev/* tools allowlist (Stage 20 PASS 2). Comma-separated emails that
# may reach the internal dev/test/simulator pages IN PRODUCTION. The central
# /app/dev layout gate is fail-closed: in production, if this is empty, NO ONE
# can open /dev/* (so beta users never reach internal tools or live-model sims).
# Outside production any authenticated user may use them (local QA / the gate).
KIPU_INTERNAL_EMAILS=
